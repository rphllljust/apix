# === MOODLE ===
MOODLE_BASE_URL=https://cursos.idep.ro.gov.br
MOODLE_URL=https://cursos.idep.ro.gov.br
MOODLE_TOKEN=SEU_TOKEN_MOODLE
MOODLE_WSFORMAT=json
MOODLE_TIMEOUT=30
MOODLE_MAX_RETRIES=3
MOODLE_DEFAULT_NEW_USER_PASSWORD=Temp@12345

# === GOOGLE SHEETS ===
GOOGLE_CREDENTIALS_FILE=credentials.json
SPREADSHEET_ID=ID_DA_PLANILHA_GOOGLE
GOOGLE_SPREADSHEET_ID=ID_DA_PLANILHA_GOOGLE
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/google-sheets/oauth/callback
GOOGLE_OAUTH_REFRESH_TOKEN=
# (O ID está na URL: https://docs.google.com/spreadsheets/d/[ESTE_ID]/edit)

# === API ===
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=GERE_UMA_CHAVE_ALEATORIA
API_RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=INFO
LOG_FILE=logs/middleware.log
CORS_ALLOWED_ORIGINS=https://cursos.idep.ro.gov.br,http://localhost:5173,http://127.0.0.1:5173
AUTH_USERNAME=admin
AUTH_PASSWORD=troque_esta_senha
AUTH_JWT_SECRET_KEY=troque_esta_chave_jwt
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_MINUTES=60
SECURITY_ENABLE_HEADERS=true
SECURITY_HSTS_SECONDS=31536000

# === FRONTEND (Docker build-time) ===
# Chave da API exposta no frontend (mesma que API_SECRET_KEY acima)
VITE_API_KEY=GERE_UMA_CHAVE_ALEATORIA
TRUST_PROXY_HEADERS=false

# === SYNC ===
SYNC_INTERVAL_MINUTES=30
SYNC_BATCH_SIZE=50

# === OPCIONAIS AVANCADOS ===
APP_NAME=Moodle Sheets Bridge
APP_ENV=prod
APP_DEBUG=false
MOODLE_REST_ENDPOINT=/webservice/rest/server.php
MOODLE_BATCH_SIZE=100
MOODLE_MAX_CONCURRENCY=20
MOODLE_DEFAULT_ROLE_ID=5
MOODLE_DEFAULT_COURSE_IDS=
MOODLE_CUSTOM_METRICS_FUNCTIONS=

GOOGLE_STUDENTS_SHEET=students
GOOGLE_COURSES_SHEET=courses
GOOGLE_CATEGORIES_SHEET=categories
GOOGLE_COURSE_CONTENTS_SHEET=course_contents
GOOGLE_ENROLLMENTS_SHEET=enrollments
GOOGLE_GRADES_SHEET=grades
GOOGLE_COMPLETION_SHEET=completion
GOOGLE_PROGRESS_SHEET=progress
GOOGLE_LOGS_SHEET=logs
GOOGLE_BADGES_SHEET=badges
GOOGLE_COMPETENCIES_SHEET=competencies
GOOGLE_GROUPS_SHEET=groups
GOOGLE_GROUP_MEMBERS_SHEET=group_members
GOOGLE_GROUPINGS_SHEET=groupings
GOOGLE_CUSTOM_METRICS_SHEET=custom_metrics
GOOGLE_STUDENTS_INPUT_SHEET=students_input
GOOGLE_ENROLLMENTS_INPUT_SHEET=Inscrever Novos Alunos
GOOGLE_SYNC_EVENTS_SHEET=Log de Sincronização
SYNC_AUTO_DIRECTION=moodle_to_sheets
SYNC_STATE_DB_PATH=data/sync_state.db


